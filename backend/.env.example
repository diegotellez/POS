# Puerto donde corre el servidor local
PORT=3000

# Secreto para firmar los JWT de sesión (cambiar en producción)
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=12h

# Ruta del archivo SQLite "de trabajo" (la BD activa, siempre local)
DB_PATH=./data/pos.db

# Carpeta donde se generan los reportes PDF
REPORTES_DIR=./data/reportes

# Carpeta local sincronizada con Google Drive Desktop (solo copias de respaldo)
DRIVE_BACKUP_DIR=

# Número de WhatsApp (con código de país, sin +) al que se envían los reportes
WHATSAPP_NUMERO=

# Impresora térmica (ver node-thermal-printer). Dejar vacío para usar el
# comprobante HTML imprimible desde el navegador como respaldo.
PRINTER_TYPE=
PRINTER_INTERFACE=
